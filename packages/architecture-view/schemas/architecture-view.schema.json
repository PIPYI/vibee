{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibee.dev/schemas/architecture-view.schema.json",
  "title": "ArchitectureViewDocument",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "components", "boundaries", "connections"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "title": { "type": "string", "minLength": 1 },
    "viewBox": {
      "type": "array",
      "items": { "type": "number", "minimum": 320 },
      "minItems": 2,
      "maxItems": 2
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "revision": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultAudience", "availableAudiences"],
      "properties": {
        "defaultAudience": { "const": "simple" },
        "availableAudiences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "enum": ["simple", "technical"] }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/component" }
    },
    "boundaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/boundary" }
    },
    "connections": {
      "type": "array",
      "items": { "$ref": "#/$defs/connection" }
    },
    "cards": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "#/$defs/card" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "label": { "type": "string" }
      }
    },
    "presentationOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "sublabel": { "type": ["string", "null"] },
        "visibility": { "enum": ["show", "hide"] }
      }
    },
    "audiencePresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "simple": { "$ref": "#/$defs/presentationOverride" },
        "technical": { "$ref": "#/$defs/presentationOverride" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "semanticRole", "semanticRefs", "label", "pos", "size"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" },
        "type": {
          "enum": [
            "frontend",
            "backend",
            "database",
            "cloud",
            "security",
            "messagebus",
            "external"
          ]
        },
        "semanticRole": { "enum": ["actor", "responsibility", "state", "external"] },
        "semanticRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "label": { "type": "string", "minLength": 1 },
        "sublabel": { "type": "string" },
        "presentation": { "$ref": "#/$defs/audiencePresentation" },
        "pos": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "size": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 2,
          "maxItems": 2
        },
        "sources": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "wraps"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" },
        "kind": { "enum": ["runtime", "region", "security-group"] },
        "semanticRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "label": { "type": "string", "minLength": 1 },
        "presentation": { "$ref": "#/$defs/audiencePresentation" },
        "wraps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "pad": { "type": "number", "minimum": 0 }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "semanticRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "label": { "type": "string" },
        "presentation": { "$ref": "#/$defs/audiencePresentation" },
        "variant": { "enum": ["default", "emphasis", "security", "dashed"] }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "items"],
      "properties": {
        "dot": {
          "enum": ["cyan", "emerald", "violet", "amber", "rose", "orange", "slate"]
        },
        "title": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "maxItems": 6,
          "items": { "type": "string" }
        }
      }
    }
  }
}
